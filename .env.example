DATABASE_URL=postgresql://jobfinder:local-development-only@localhost:54329/jobfinder
APP_ORIGIN=http://localhost:3000
# Optional: comma-separated hostnames permitted for JSON-LD discovery.
# Example: JSON_LD_ALLOWED_HOSTS=example.com, careers.example.org
JSON_LD_ALLOWED_HOSTS=
# Secure key setup supplies OPENAI_API_KEY in ignored .env.local.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXPLANATION_MODEL=gpt-5.4-mini
# Optional: USAJOBS feed credentials. Request a key at developer.usajobs.gov;
# the API authenticates on the registered email address, not a bearer token.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Optional: Adzuna feed credentials from developer.adzuna.com.
# ADZUNA_COUNTRY is a two-letter country code and defaults to us.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=
# Browser crawler service. Unset means the captured-API and browser rungs are
# skipped and discovery falls back to AI extraction, with a warning on the
# candidate's activity feed.
CRAWLER_URL=http://crawler:4000
CRAWLER_SECRET=
